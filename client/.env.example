# Social login is configured SERVER-SIDE only (see server/.env.example):
# GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET. The login page asks the API which
# providers are ready and enables the button automatically, so no client-side
# OAuth values or rebuild are required.

# Stripe - real online card payments. Public publishable key (safe to expose).
# The matching secret lives in server/.env as STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=
